name = "CXREN/CBAKD"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/CXREN/CBAKD"

license = "Apache-2.0"

keywords = [
  "linear-algebra",
  "matrix",
  "vector",
  "lu",
  "cholesky",
  "qr",
  "eigenvalue",
  "eigenvector",
  "svd",
  "least-squares",
  "pca",
  "solver",
  "numerical",
]

preferred_target = "wasm"

description = "Pure-MoonBit dense numerical linear algebra: Matrix and Vector types, LU / Cholesky / QR factorizations, linear-system solvers, least squares, symmetric eigenvalue decomposition, SVD, and PCA — with no native dependencies."
